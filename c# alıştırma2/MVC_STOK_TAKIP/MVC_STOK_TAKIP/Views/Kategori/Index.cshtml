@using MVC_STOK_TAKIP.Models.Entity;
@model List<TBL_KATEGORI>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>KATEGORİ ADI</th>
            <th>SİL</th>
            <th>GÜNCELLE</th>
        </tr>

    </thead>
    

    @foreach (var x in Model)
    {

        <tr>
            <td>@x.ID</td>
            <td>@x.AD</td>
            <td> <a href="/Kategori/KategoriSil/@x.ID" class="btn btn-danger">Sil</a> </td>
            <td> <a href="/Kategori/KategoriGetir/@x.ID" class="btn btn-success">Güncelle</a> </td>
        </tr>


    }



</table>

<a href="/Kategori/YeniKategori" class="btn btn-primary">Yeni Kategori Ekle</a>
