@model MVC_STOK_TAKIP.Models.Entity.TBL_URUN
@{
    ViewBag.Title = "UrunGetir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using (Html.BeginForm("Guncelle", "Urunler", FormMethod.Post))
{
    <form method="post">

        <div style="display: flex; flex-wrap: wrap; gap: 16px;">

            <div class="form-group" style="flex: 1; min-width: 200px;">
                <label>Ad</label>
                @Html.TextBoxFor(m => m.AD, new { @class = "form-control" })
            </div>

            <div class="form-group" style="flex: 1; min-width: 200px;">
                <label>Marka</label>
                @Html.TextBoxFor(m => m.MARKA, new { @class = "form-control" })
            </div>
        </div>


        <div style="display: flex; flex-wrap: wrap; gap: 16px;">


            <div class="form-group" style="flex: 1; min-width: 200px;">
                <label>Stok</label>
                @Html.TextBoxFor(m => m.STOK, new { @class = "form-control" })
            </div>

            <div class="form-group" style="flex: 1; min-width: 200px;">
                <label>Alış Fiyat</label>
                @Html.TextBoxFor(m => m.ALIS_FIYAT, new { @class = "form-control" })
            </div>
        </div>


        <div style="display: flex; flex-wrap: wrap; gap: 16px;">


            <div class="form-group" style="flex: 1; min-width: 200px;">
                <label>Satış Fiyat</label>
                @Html.TextBoxFor(m => m.SATIS_FIYAT, new { @class = "form-control" })
            </div>

            <div class="form-group" style="flex: 1; min-width: 200px;">
                <label>Kategori Adı</label>
                @Html.DropDownListFor(m => m.TBL_KATEGORI.ID, (List<SelectListItem>)ViewBag.urun_kat, "Belirtilmemiş", new { @class = "form-control" })
            </div>
        </div>

        @Html.HiddenFor(m => m.ID)
        <button type="submit" class="btn btn-primary" style="margin-top: 16px;">Güncelle</button>

    </form>





}
