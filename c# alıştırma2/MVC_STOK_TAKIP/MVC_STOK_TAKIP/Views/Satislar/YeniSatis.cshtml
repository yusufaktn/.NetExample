@model MVC_STOK_TAKIP.Models.Entity.TBL_SATIS

@{
    ViewBag.Title = "YeniUrun";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form method="post">

    <div class="form-group">
        <label>Ürün ID</label>
        @Html.DropDownListFor(m => m.TBL_URUN.ID, (List<SelectListItem>)ViewBag.urun, "Belirtilmemiş", new { @class = "form-control" })


    </div>
    <div class="form-group">
        <label>Müşteri ID</label>
        @Html.DropDownListFor(m => m.TBL_MUSTERI.ID, (List<SelectListItem>)ViewBag.müsteri, "Belirtilmemiş", new { @class = "form-control" })


    </div>
    <div class="form-group">
        <label>Personel ID</label>
        @Html.DropDownListFor(m => m.TBL_PERSONEL.ID, (List<SelectListItem>)ViewBag.personel, "Belirtilmemiş", new { @class = "form-control" })

    </div>
    <div class="form-group">
        <label>Fiyat</label>
        <input type="text" class="form-control" placeholder="Fiyat Girn" name="FIYAT">

    </div>

    <div class="form-group">
        <label>Tarih</label>
        <input type="text" class="form-control" placeholder="Tarih Girn" name="TARIH">

    </div>

    <button type="submit" class="btn btn-primary">Ekle</button>

</form>
