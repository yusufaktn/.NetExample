@model MVC_STOK_TAKIP.Models.Entity.TBL_MUSTERI

@{
    ViewBag.Title = "YeniMusteri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<form method="post">

    <div class="form-group">
        <label>Müşteri Adı</label>
        <input type="text" class="form-control" placeholder="Müşteri Adı Girin" name="AD">
        @Html.ValidationMessageFor(x => x.AD, "", new {@style="color : red"})

    </div>
    <div class="form-group">
        <label>Müşteri Soyadı</label>
        <input type="text" class="form-control" placeholder="Nüşteri Soyadı Girin" name="SOYAD">
        @Html.ValidationMessageFor(x => x.SOYAD, "", new { @style = "color : red" })

    </div>
    <div class="form-group">
        <label>Toplam Harcama</label>
        <input type="text" class="form-control" placeholder="Topla Harcama" name="BAKIYE">

    </div>
    <div class="form-group">
        <label>Şehir</label>
        <input type="text" class="form-control" placeholder="Şehir Girin" name="SEHIR">

    </div>

    <button type="submit" class="btn btn-primary">Ekle</button>

</form>