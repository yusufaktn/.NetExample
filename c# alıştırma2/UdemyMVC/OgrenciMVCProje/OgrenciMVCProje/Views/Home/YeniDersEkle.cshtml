
@{
    ViewBag.Title = "YeniDersEkle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="post">
    <div class="form-group" >
        <label>Ders Adı</label>
        <input type="text" class="form-control" placeholder="Ders adı girin" name="DERSAD">
        <small id="emailHelp" class="form-text text-muted">Eklemek istediğiniz dersin adını giriniz.</small>
    </div>
    
   
    <button type="submit" class="btn btn-primary">Ekle</button>
</form>

