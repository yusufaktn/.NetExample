
@{
    ViewBag.Title = "YeniKulüp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="post">
    <div class="form-group">
        <label>Kulüp Adı</label>
        <input type="text" class="form-control" placeholder="Kulüp adı girin" name="KULUP_ADI">
        <small id="emailHelp" class="form-text text-muted">Eklemek istediğiniz dersin adını giriniz.</small>
    </div>


    <button type="submit" class="btn btn-primary">Ekle</button>
</form>


