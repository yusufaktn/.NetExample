@model Film_Koleksiyonu_MVC.Models.Tbl_Movie

@{
    ViewData["Title"] = "Film Sil";
}

<div class="container fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">Film Sil</h2>

                    <div class="alert alert-danger">
                        <h4 class="alert-heading">Dikkat!</h4>
                        <p>Bu filmi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Title">
                        </div>
                        <div class="col-md-8">
                            <h5>@Model.Title</h5>
                            <p class="text-muted">@Model.Category?.Name</p>
                            <div class="rating">
                                @for (int i = 0; i < Model.Rating; i++)
                                {
                                    <i class="fas fa-star text-warning"></i>
                                }
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="MovieId" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-2"></i>Sil
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>