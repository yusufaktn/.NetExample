@{
    ViewData["Title"] = "Erişim Reddedildi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow">
                <div class="card-body p-5">
                    <i class="bi bi-shield-lock text-danger" style="font-size: 4rem;"></i>
                    <h2 class="mt-4">Erişim Reddedildi</h2>
                    <p class="text-muted mb-4">Bu sayfaya erişim yetkiniz bulunmamaktadır.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
            <style>
                .card {
                    border-radius: 15px;
                    border: none;
                }
            </style>
}