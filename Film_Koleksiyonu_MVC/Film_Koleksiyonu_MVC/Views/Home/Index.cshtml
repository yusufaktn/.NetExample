@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">Film Koleksiyonuna Hoş Geldiniz</h2>
                    <p class="card-text">Film koleksiyonunuzu yönetin, arkadaşlarınızla paylaşın ve yeni filmler
                        keşfedin.</p>
                    <a asp-controller="Movies" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Yeni Film Ekle
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-film"></i> Son Eklenen Filmler
                            </h5>
                            <div class="row">
                                @foreach (var movie in ViewBag.RecentMovies ?? new List<dynamic>())
                                {
                                    <div class="col-md-3 mb-3">
                                        <div class="card movie-card">
                                            <img src="@movie.ImageUrl" class="card-img-top" alt="@movie.Title">
                                            <div class="card-body">
                                                <h6 class="card-title">@movie.Title</h6>
                                                <p class="card-text">
                                                    <small class="text-muted">@movie.Category?.Name</small>
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="rating" data-rating="@movie.Rating">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="bi @(i <= movie.Rating ? "bi-star-fill" : "bi-star")"></i>
                                                        }
                                                    </div>
                                                    <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })"
                                                        class="btn btn-sm btn-outline-primary">
                                                        Detaylar
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4 stats-card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-graph-up"></i> İstatistikler
                    </h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Toplam Film
                            <span class="badge bg-primary rounded-pill">@ViewBag.MovieCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Arkadaşlar
                            <span class="badge bg-primary rounded-pill">@ViewBag.FriendCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Film Önerileri
                            <span class="badge bg-primary rounded-pill">@ViewBag.SuggestionCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Toplam Puan
                            <span class="badge bg-primary rounded-pill">@ViewBag.RatingCount</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-lightbulb"></i> Arkadaş Önerileri
                    </h5>
                    <div class="list-group list-group-flush">
                        @foreach (var suggestion in ViewBag.FriendSuggestions ?? new List<dynamic>())
                        {
                            <div class="list-group-item">
                                <div class="d-flex align-items-center mb-2">
                                    <img src="@suggestion.FriendProfileImage" class="profile-image me-2"
                                        alt="@suggestion.FriendName">
                                    <div>
                                        <h6 class="mb-0">@suggestion.FriendName</h6>
                                        <small class="text-muted">önerdi:</small>
                                    </div>
                                </div>
                                <a href="@Url.Action("Details", "Movies", new { id = suggestion.MovieId })"
                                    class="text-decoration-none">
                                    <h6 class="mb-0 text-primary">@suggestion.MovieTitle</h6>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sayfa yüklendiğinde animasyonları başlat
        document.addEventListener('DOMContentLoaded', function () {
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
}
